{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=photos_db;Username=postgres;Password=postgres;Port=5432;"
  },
  "Authentication": {
    "Keycloak": {
      "Authority": "http://localhost:8090/realms/DatingApp",
      "ClientId": "photo-service",
      "Audience": "photo-service",
      "RequireHttpsMetadata": false,
      "ValidIssuers": [
        "http://localhost:8090/realms/DatingApp",
        "http://127.0.0.1:8090/realms/DatingApp",
        "http://10.0.2.2:8090/realms/DatingApp"
      ],
      "Audiences": [
        "photo-service",
        "yarp-gateway",
        "account"
      ]
    }
  },
  "Storage": {
    "PhotosPath": "wwwroot/uploads/photos"
  },
  "PhotoCleanup": {
    "Enabled": true,
    "RunAtHour": 2,
    "SoftDeleteGracePeriodDays": 30
  },
  "AllowedHosts": "*"
}
